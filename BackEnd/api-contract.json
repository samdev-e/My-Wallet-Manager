{
    "openapi": "3.0.3",
    "info": {
        "title": "My Wallet Manager API",
        "description": "REST API for managing user accounts, categories, and financial transactions. Authentication is handled via JWT Bearer tokens.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local development server"
        }
    ],
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        },
        "schemas": {
            "TokenObtain": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string"
                    },
                    "password": {
                        "type": "string"
                    }
                },
                "required": [
                    "username",
                    "password"
                ]
            },
            "TokenResponse": {
                "type": "object",
                "properties": {
                    "access": {
                        "type": "string"
                    },
                    "refresh": {
                        "type": "string"
                    }
                }
            },
            "Account": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "balance": {
                        "type": "number",
                        "format": "decimal"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Category": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "PaginatedResponse": {
                "type": "object",
                "properties": {
                    "total_items": {
                        "type": "integer",
                        "description": "Total number of items across all pages"
                    },
                    "total_pages": {
                        "type": "integer",
                        "description": "Total number of pages"
                    },
                    "current_page": {
                        "type": "integer",
                        "description": "Current page number"
                    },
                    "page_size": {
                        "type": "integer",
                        "description": "Number of items per page"
                    },
                    "next": {
                        "type": "string",
                        "nullable": true,
                        "description": "URL to next page (null if last page)"
                    },
                    "previous": {
                        "type": "string",
                        "nullable": true,
                        "description": "URL to previous page (null if first page)"
                    },
                    "results": {
                        "type": "array",
                        "description": "Array of items for current page"
                    }
                }
            },
            "Transaction": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "type": {
                        "type": "string",
                        "description": "Transaction type",
                        "enum": [
                            "income",
                            "expense"
                        ]
                    },
                    "account": {
                        "type": "integer",
                        "description": "Account ID"
                    },
                    "category": {
                        "type": "integer",
                        "description": "Category ID. Must be owned by the authenticated user and have the same type as the transaction (income category for income transactions, expense category for expense transactions)"
                    },
                    "amount": {
                        "type": "number",
                        "format": "decimal"
                    },
                    "date": {
                        "type": "string",
                        "format": "date"
                    },
                    "note": {
                        "type": "string",
                        "nullable": true
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "type",
                    "account",
                    "category",
                    "amount",
                    "date"
                ]
            }
        }
    },
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/api/token/": {
            "post": {
                "summary": "Obtain JWT token pair",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenObtain"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "JWT access and refresh tokens",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/token/refresh/": {
            "post": {
                "summary": "Refresh JWT access token",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "refresh": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "refresh"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "New access token"
                    }
                }
            }
        },
        "/api/accounts/": {
            "get": {
                "summary": "List accounts",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Page number for pagination"
                    },
                    {
                        "name": "page_size",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "default": 10
                        },
                        "description": "Number of results per page (max 100, default 10)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of accounts",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/PaginatedResponse"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "results": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Account"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create account",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Account"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Account created"
                    }
                }
            }
        },
        "/api/categories/": {
            "get": {
                "summary": "List categories",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Page number for pagination"
                    },
                    {
                        "name": "page_size",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "default": 10
                        },
                        "description": "Number of results per page (max 100, default 10)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of categories",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/PaginatedResponse"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "results": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Category"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create category",
                "responses": {
                    "201": {
                        "description": "Category created"
                    }
                }
            }
        },
        "/api/transactions/": {
            "get": {
                "summary": "List transactions",
                "description": "Get paginated list of transactions with optional filtering, searching, and ordering",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Page number for pagination"
                    },
                    {
                        "name": "page_size",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "maximum": 100,
                            "default": 10
                        },
                        "description": "Number of results per page (max 100, default 10)"
                    },
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": ["income", "expense"]
                        },
                        "description": "Filter by transaction type"
                    },
                    {
                        "name": "account",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Filter by account ID"
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Filter by category ID"
                    },
                    {
                        "name": "start_date",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        },
                        "description": "Filter transactions from this date (YYYY-MM-DD)"
                    },
                    {
                        "name": "end_date",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        },
                        "description": "Filter transactions until this date (YYYY-MM-DD)"
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Search in note and description fields (case-insensitive)"
                    },
                    {
                        "name": "ordering",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": ["date", "-date", "amount", "-amount", "created_at", "-created_at"]
                        },
                        "description": "Order results by field (prefix with - for descending). Default: -date"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated and filtered list of transactions",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/PaginatedResponse"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "results": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Transaction"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create transaction",
                "description": "Create a new transaction. Automatically updates the linked account balance. Category must be owned by the user and have the same type as the transaction.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Transaction"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Transaction created successfully"
                    },
                    "400": {
                        "description": "Validation error - category type does not match transaction type or category not owned by user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "category": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            },
                                            "example": ["For income transactions, only income categories are allowed."]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}